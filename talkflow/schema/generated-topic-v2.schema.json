{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebox.example/talkflow/generated-topic-v2.schema.json",
  "title": "TheBox Talk Flow Generated Topic v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "sessionOne",
    "sessionTwo",
    "conversationMaterials",
    "speakingFrames",
    "leaderGuide",
    "bilingualInstructions"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "category": { "type": "string", "minLength": 1 },
    "title": { "$ref": "#/$defs/bilingual" },
    "generationEngine": { "const": "v2-fail-closed" },
    "generatedConversation": { "const": true },
    "standardVersion": { "const": "2" },
    "templateVersion": { "const": "4" },
    "generationRequest": { "type": "object" },
    "topicPlan": { "type": "object" },
    "promptAxes": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "speakingMechanisms": { "type": "object" },
    "sessionOne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "sections"],
      "properties": {
        "minutes": { "const": 50 },
        "sections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/quickStart" },
            { "$ref": "#/$defs/personalExperience" },
            { "$ref": "#/$defs/evidenceDecision" },
            { "$ref": "#/$defs/shortWrapUp" }
          ],
          "items": false
        }
      }
    },
    "sessionTwo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "sections"],
      "properties": {
        "minutes": { "const": 40 },
        "sections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/reset" },
            { "$ref": "#/$defs/mainActivity" },
            { "$ref": "#/$defs/roleChallenge" },
            { "$ref": "#/$defs/finalDecision" }
          ],
          "items": false
        }
      }
    },
    "conversationMaterials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "title", "items", "decisionPrompt"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "title": { "$ref": "#/$defs/bilingual" },
          "items": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/bilingual" }
          },
          "decisionPrompt": { "$ref": "#/$defs/bilingual" }
        }
      }
    },
    "speakingFrames": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["purpose", "en", "ko"],
        "properties": {
          "purpose": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 },
          "ko": { "type": "string", "minLength": 1 }
        }
      }
    },
    "leaderGuide": {
      "type": "object",
      "required": ["timingEn", "timingKo", "supportEn", "supportKo"],
      "properties": {
        "timingEn": { "type": "string", "minLength": 1 },
        "timingKo": { "type": "string", "minLength": 1 },
        "supportEn": { "type": "string", "minLength": 1 },
        "supportKo": { "type": "string", "minLength": 1 }
      }
    },
    "bilingualInstructions": {
      "type": "object",
      "required": [
        "orderEn",
        "orderKo",
        "rolesEn",
        "rolesKo",
        "timeEn",
        "timeKo",
        "finalResultEn",
        "finalResultKo",
        "alternativeParticipationEn",
        "alternativeParticipationKo"
      ]
    },
    "quality": { "type": "object" },
    "operatorStatus": { "type": "object" },
    "hidden": { "type": "boolean" },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ko"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ko": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "labelEn", "labelKo", "minutes", "content"]
    },
    "quickStart": { "$ref": "#/$defs/section" },
    "personalExperience": { "$ref": "#/$defs/section" },
    "evidenceDecision": { "$ref": "#/$defs/section" },
    "shortWrapUp": { "$ref": "#/$defs/section" },
    "reset": { "$ref": "#/$defs/section" },
    "mainActivity": { "$ref": "#/$defs/section" },
    "roleChallenge": { "$ref": "#/$defs/section" },
    "finalDecision": { "$ref": "#/$defs/section" }
  }
}
